# Cấu hình Hadoop cho image apache/hadoop: biến môi trường được đổi thành *-site.xml.
HDFS_NAMENODE_USER=root
HDFS_DATANODE_USER=root
HDFS_SECONDARYNAMENODE_USER=root

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_hadoop.tmp.dir=/hadoop/tmp
CORE-SITE.XML_hadoop.http.staticuser.user=root

HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data
# Một DataNode trong môi trường lab, nên replication 1. Thêm node mới thì sửa cả hai nơi:
# file này và HDFS_REPLICATION của service spark.
HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.namenode.rpc-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.namenode.http-bind-host=0.0.0.0
HDFS-SITE.XML_dfs.datanode.hostname=datanode
# Spark nói chuyện với DataNode bằng hostname container, không bằng IP nội bộ.
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.permissions.enabled=false
