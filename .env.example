# Producer settings. Defaults are in src/producer/config.py.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC=wikipedia-recent-changes
WIKI_USER_AGENT=wikipedia-realtime-analytics/0.1 (https://github.com/noway165/BigData)
STATS_INTERVAL_S=30

# Raw sink settings. Defaults are in src/streaming/raw_to_hdfs.py.
RAW_OUTPUT_PATH=hdfs://namenode:8020/data/raw/recent_changes
RAW_CHECKPOINT_PATH=hdfs://namenode:8020/checkpoints/raw_to_hdfs
RAW_TRIGGER=30 seconds

# Infrastructure, read by docker-compose.yml.
KAFKA_HOST_PORT=9094
KAFKA_CLUSTER_ID=wiki-rt-analytics-cluster
KAFKA_HEAP_OPTS=-Xms512m -Xmx512m
HDFS_UI_PORT=9870
SPARK_UI_PORT=4040
SPARK_IMAGE=apache/spark:3.5.6-scala2.12-java11-python3-ubuntu

# Topics created by scripts/bootstrap.sh.
KAFKA_ANALYTICS_TOPIC=wikipedia-analytics
KAFKA_REPLAY_TOPIC=wikipedia-replay
KAFKA_PARTITIONS=3
KAFKA_RETENTION_MS=86400000

# Analytics job settings. Defaults are in src/streaming/analytics_job.py.
WATERMARK=1 minute
ANALYTICS_METRICS=edit_count,bot_ratio,activity_spike
ANALYTICS_CHECKPOINT_ROOT=hdfs://namenode:8020/checkpoints
ANALYTICS_TRIGGER=10 seconds
ANALYTICS_STARTING_OFFSETS=latest
ANALYTICS_MAX_OFFSETS_PER_TRIGGER=50000
# Empty counts every event type; "edit,new" counts only real edits.
ANALYTICS_EVENT_TYPES=
SPIKE_MIN_EDITS=10
SPIKE_MIN_DISTINCT_USERS=0

# Dashboard. A fresh group id per start replays the topic's 24h retention,
# so the page shows data immediately instead of waiting for the first window.
DASHBOARD_PORT=8501
LIVEFEED_PORT=8080
DASHBOARD_REFRESH_S=5
DASHBOARD_GROUP_ID=
DASHBOARD_LOG_WIKIS=enwiki,viwiki
DASHBOARD_LOG_LINES=60

# Experiments. Only set these for an experiment run, never for the demo pipeline.
CHECKPOINT_SUFFIX=
RUN_SECONDS=0
METRICS_OUT=
RECOVERY_RUN1_SECONDS=240
RECOVERY_GAP_SECONDS=60
RECOVERY_RUN2_SECONDS=240
WM_SAMPLE_SIZE=20000
WM_RUN_SECONDS=180
